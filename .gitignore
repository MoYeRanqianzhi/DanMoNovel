# ============================================================
# 耽墨小说 · Git 忽略规则
# 规则按"为什么不提交"分组，新增条目请放进对应分组并写明原因。
# ============================================================

# ---- 依赖与构建产物：可由 package.json / 源码随时重新生成 ----
node_modules/
dist/
*.tsbuildinfo
# React Router：typegen 生成的路由类型（./+types/<路由>）与各站的构建产物
.react-router/
apps/*/build/

# ---- 本地工作树：约定放在主检出目录的 .worktrees/ 下，永不提交 ----
/.worktrees/

# ---- 本地记忆与私有记录 ----
# .agents/ 下所有名称含 ".local" 的文件或目录（如 MEMORY.local.md、
# memory/xxx.local.md、memory.local/）只属于当前机器或当前贡献者，
# 可能包含私有路径、账号或偏好，任何情况下都不得强制加入版本库。
.agents/**/*.local*

# ---- 编辑器、系统与调试工具产生的临时文件 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
# 浏览器自动化（Playwright MCP）验收时生成的截图与快照
.playwright-mcp/
