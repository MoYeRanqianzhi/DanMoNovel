# ============================================================
# 耽墨小说 · Git 忽略规则
# 规则按"为什么不提交"分组，新增条目请放进对应分组并写明原因。
# ============================================================

# ---- 依赖与构建产物：可由 package.json / 源码随时重新生成 ----
node_modules/
dist/
*.tsbuildinfo
# React Router：typegen 生成的路由类型（./+types/<路由>）与各站的构建产物
.react-router/
apps/*/build/

# Keep user- and machine-specific agent records out of shared history.
# A `.local` segment in a name marks a record local: MEMORY.local.md,
# TODO.local.md, memory/<name>.local.md, plan/<name>.local.md.
# Match the segment exactly. A looser `*.local*` also hides shared files whose
# names merely contain "local" after a dot, such as i18n.locale.md.
/.agents/**/*.local.*
# Extensionless files and directories marked `.local` are local as well.
/.agents/**/*.local

# Worktrees have their own Git state and must not enter the main checkout's history.
# Agents create them under .worktrees/ unless a client's worktree tool has its own
# default location; Claude Code's tool uses .claude/worktrees/.
/.worktrees/
/.claude/worktrees/

# ---- 编辑器、系统与调试工具产生的临时文件 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
# 浏览器自动化（Playwright MCP）验收时生成的截图与快照
.playwright-mcp/
